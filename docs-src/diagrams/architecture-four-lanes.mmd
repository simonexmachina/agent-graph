flowchart TB
    subgraph observeLane["OBSERVE · attention selects a resource"]
        direction LR
        o1["Focused supported page"] --> o2["Chrome extension"] --> o3["Connector fetch"] --> o4[("Local graph<br/>records observation")]
    end

    subgraph fetchLane["FETCH · a client requests specific context"]
        direction LR
        f1["Agent or CLI"] --> f2["Missing or stale resource"] --> f3["Connector fetch"] --> f4[("Local graph<br/>stores context")]
    end

    subgraph refreshLane["REFRESH · polling maintains known context"]
        direction LR
        r1["Polling"] --> r2["Known resources"] --> r3["Connector fetch"] --> r4[("Local graph<br/>updates changes")]
    end

    subgraph expiryLane["EXPIRY · retention limits the working set"]
        direction LR
        e1["Retention model"] --> e2[("Local graph")] --> e3["Expired content removed"]
    end

    o1 ~~~ f1
    f1 ~~~ r1
    r1 ~~~ e1

    classDef observe fill:#e9fff6,stroke:#008566,color:#082b22,stroke-width:2px;
    classDef fetch fill:#fff7d6,stroke:#b87900,color:#342500,stroke-width:2px;
    classDef refresh fill:#eef2ff,stroke:#6366f1,color:#1e1b4b,stroke-width:2px;
    classDef expiry fill:#ffe9f1,stroke:#c83264,color:#35101f,stroke-width:2px;
    class o1,o2,o3,o4 observe;
    class f1,f2,f3,f4 fetch;
    class r1,r2,r3,r4 refresh;
    class e1,e2,e3 expiry;
