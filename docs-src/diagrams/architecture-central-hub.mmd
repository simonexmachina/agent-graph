flowchart TB
    services["Selected services<br/>Gmail · Drive · Slack · Discord · RSS · Web"] <--> connectors["Connector packages<br/>Fetch · translate"]

    observe["OBSERVE<br/>Focused page<br/>Chrome extension"] --> connectors
    fetch["FETCH<br/>Agent or CLI<br/>Missing or stale"] --> connectors
    refresh["REFRESH<br/>Polling<br/>Known resources"] --> connectors

    connectors -->|"entities · people · edges"| database[("LOCAL GRAPH<br/>SQLite · FTS · vectors")]
    database --> expiry["EXPIRY<br/>Retention model<br/>Remove old content"]
    database <--> access["MCP · CLI<br/>Search · traverse · fetch"]
    access <--> agent["Your existing<br/>coding agent"]

    classDef source fill:#edf4ff,stroke:#2563eb,color:#10213a,stroke-width:2px;
    classDef observe fill:#e9fff6,stroke:#008566,color:#082b22,stroke-width:2px;
    classDef fetch fill:#fff7d6,stroke:#b87900,color:#342500,stroke-width:2px;
    classDef refresh fill:#eef2ff,stroke:#6366f1,color:#1e1b4b,stroke-width:2px;
    classDef expiry fill:#ffe9f1,stroke:#c83264,color:#35101f,stroke-width:2px;
    classDef core fill:#f5f5f5,stroke:#52525b,color:#18181b,stroke-width:2px;
    class services source;
    class observe observe;
    class fetch fetch;
    class refresh refresh;
    class expiry expiry;
    class connectors,database,access,agent core;
