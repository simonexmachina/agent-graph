flowchart LR
    observe["OBSERVE<br/>Focused page → Chrome extension"] --> resolve["Resolve resource<br/>through owning connector"]
    fetch["FETCH<br/>Agent or CLI → missing or stale"] --> resolve
    services["Selected services"] <--> resolve
    resolve -->|"fetch · translate · upsert"| database[("Local graph<br/>Useful working set")]
    database -->|"known resources"| refresh["REFRESH<br/>Polling detects changes"]
    refresh --> resolve
    database -->|"outside retention"| expiry["EXPIRY<br/>Retention model"]
    expiry --> removed["Expired content<br/>removed"]
    database <--> access["MCP · CLI<br/>Agent access"]

    classDef source fill:#edf4ff,stroke:#2563eb,color:#10213a,stroke-width:2px;
    classDef observe fill:#e9fff6,stroke:#008566,color:#082b22,stroke-width:2px;
    classDef fetch fill:#fff7d6,stroke:#b87900,color:#342500,stroke-width:2px;
    classDef refresh fill:#eef2ff,stroke:#6366f1,color:#1e1b4b,stroke-width:2px;
    classDef expiry fill:#ffe9f1,stroke:#c83264,color:#35101f,stroke-width:2px;
    classDef core fill:#f5f5f5,stroke:#52525b,color:#18181b,stroke-width:2px;
    class services source;
    class observe observe;
    class fetch fetch;
    class refresh refresh;
    class expiry,removed expiry;
    class resolve,database,access core;
