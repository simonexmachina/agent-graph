flowchart TB
    services["Selected services<br/>Gmail · Drive · Slack · Discord · RSS · Web"]

    subgraph local["Your machine"]
        direction TB
        subgraph inputs["Context lifecycle"]
            direction TB
            observe["OBSERVE<br/>Chrome extension sends observations"]
            fetch["FETCH<br/>Agents can also request new entries"]
            refresh["REFRESH<br/>Polling updates resources"]
        end

        connectors["Connector packages<br/>Fetch entities from services"]
        database[("Local graph<br/>SQLite · FTS · vectors")]
        expiry["EXPIRY<br/>Retention model"]
        access["CLI or MCP<br/>Search · traverse · fetch"]
        agent["Your existing<br/>coding agent"]

        observe --> connectors
        fetch --> connectors
        refresh --> connectors
        connectors -->|"entities · people · edges"| database
        database -->|"content outside retention"| expiry
        database <--> access
        access <--> agent
    end

    services <--> connectors

    classDef source fill:#edf4ff,stroke:#2563eb,color:#10213a,stroke-width:2px;
    classDef observe fill:#e9fff6,stroke:#008566,color:#082b22,stroke-width:2px;
    classDef fetch fill:#fff7d6,stroke:#b87900,color:#342500,stroke-width:2px;
    classDef refresh fill:#eef2ff,stroke:#6366f1,color:#1e1b4b,stroke-width:2px;
    classDef expiry fill:#ffe9f1,stroke:#c83264,color:#35101f,stroke-width:2px;
    classDef core fill:#f5f5f5,stroke:#52525b,color:#18181b,stroke-width:2px;
    class services source;
    class observe observe;
    class fetch fetch;
    class refresh refresh;
    class expiry expiry;
    class connectors,database,access,agent core;
