{
  "manifest_version": 3,
  "name": "AgentGraph Extension",
  "version": "0.1.0",
  "description": "Watches browser activity and triggers AgentGraph to fetch content when you dwell on a supported URL.",
  "permissions": ["tabs", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AgentGraph"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content-gmail.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://mail.google.com/*"
  ]
}
